@model PagedResult<EventListItemDto>
@{
    ViewData["Title"] = "Upcoming events";
}

<section class="hero p-4 p-md-5 mb-4 rounded-3 text-white shadow-sm">
    <div class="col-lg-8 px-0">
        <h1 class="display-5 fw-bold">Find your next event</h1>
        <p class="lead mb-4">Concerts, theatre, comedy and more. Secure your tickets in a few clicks.</p>
        <form method="get" asp-controller="Home" asp-action="Index" class="row g-2">
            <div class="col-md-8">
                <input name="search" value="@ViewBag.Search" class="form-control form-control-lg"
                       placeholder="Search by title, description or city" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-warning btn-lg w-100" type="submit">Search</button>
            </div>
        </form>
    </div>
</section>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No events match your search yet.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top event-cover" alt="@item.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary">@item.StartsAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                            <span class="rating-stars fw-semibold">★ @item.AverageRating.ToString("0.0")</span>
                        </div>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="text-muted mb-2">@item.VenueName, @item.City</p>
                        <div class="mt-auto d-flex justify-content-between align-items-end">
                            <div>
                                <div class="fw-bold">from €@item.MinPrice.ToString("0.00")</div>
                                <small class="text-muted">@item.AvailableTickets tickets left · @item.ReviewCount reviews</small>
                            </div>
                            <a class="btn btn-outline-primary" asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Event pages">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@(Model.Page - 1)">Previous</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@(Model.Page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
}
