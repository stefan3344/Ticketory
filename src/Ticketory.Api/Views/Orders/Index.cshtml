@model IReadOnlyList<OrderDto>
@{
    ViewData["Title"] = "My orders";
}

<h1 class="h3 mb-3">My orders</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have no orders yet. <a asp-controller="Home" asp-action="Index">Browse events</a>.
    </div>
}
else
{
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order</th>
                    <th>Placed</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Items</th>
                    <th>Tickets</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var badge = order.Status switch
                    {
                        OrderStatus.Paid => "bg-success",
                        OrderStatus.Pending => "bg-warning text-dark",
                        OrderStatus.Failed => "bg-danger",
                        OrderStatus.Cancelled => "bg-secondary",
                        OrderStatus.Refunded => "bg-info",
                        _ => "bg-info"
                    };

                    <tr>
                        <td><code>@order.Id.ToString()[..8]</code></td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="badge @badge">@order.Status</span></td>
                        <td>€@order.TotalAmount.ToString("0.00")</td>
                        <td>@order.Items.Sum(i => i.Quantity)</td>
                        <td>@order.Tickets.Count</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
