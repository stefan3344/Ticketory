@model IReadOnlyList<TicketDto>
@{
    ViewData["Title"] = "My tickets";
}

<h1 class="h3 mb-3">My tickets</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have no tickets yet. <a asp-controller="Home" asp-action="Index">Browse events</a>.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var ticket in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex gap-3">
                        <img class="qr-image" src="@Url.Action("Qr", "Tickets", new { code = ticket.Code })" alt="QR code for @ticket.Code" />
                        <div>
                            <h5 class="h6 mb-1">@ticket.EventTitle</h5>
                            <div class="text-muted small">@ticket.TicketTypeName</div>
                            <div class="small">@ticket.StartsAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                            <code class="small d-block my-1">@ticket.Code</code>
                            <span class="badge @(ticket.Status == TicketStatus.Issued ? "bg-success" : ticket.Status == TicketStatus.CheckedIn ? "bg-info" : "bg-secondary")">@ticket.Status</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
