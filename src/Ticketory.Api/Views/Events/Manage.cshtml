@model IReadOnlyList<EventListItemDto>
@{
    ViewData["Title"] = "Manage events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Manage events</h1>
    <a class="btn btn-primary" asp-action="Create">Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have not created any events yet.</div>
}
else
{
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Venue</th>
                    <th>Status</th>
                    <th>Available</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Title</td>
                        <td>@item.StartsAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@item.VenueName, @item.City</td>
                        <td>
                            <span class="badge @(item.Status == EventStatus.Published ? "bg-success" : item.Status == EventStatus.Draft ? "bg-secondary" : item.Status == EventStatus.Cancelled ? "bg-danger" : "bg-info")">
                                @item.Status
                            </span>
                        </td>
                        <td>@item.AvailableTickets</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="TicketTypes" asp-action="Index" asp-route-eventId="@item.Id">Tickets</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
