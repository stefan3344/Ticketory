@model VenueFormViewModel
@{
    ViewData["Title"] = "Add venue";
}

<h1 class="h3 mb-3">Add venue</h1>
<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <partial name="_VenueForm" model="Model" />
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Create venue</button>
                <a class="btn btn-link" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
