@model AdminMessagesViewModel
@{
    ViewData["Title"] = "Outbox messages";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Outbox messages</h1>
        <p class="text-muted mb-0">History of messages published by the application.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to dashboard</a>
</div>

<form method="get" asp-action="Messages" class="card card-body shadow-sm border-0 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="type">Message type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var messageType in Model.Types)
                {
                    if (messageType == Model.Type)
                    {
                        <option value="@messageType" selected>@messageType</option>
                    }
                    else
                    {
                        <option value="@messageType">@messageType</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="processed">Status</label>
            <select id="processed" name="processed" class="form-select">
                <option value="">All statuses</option>
                @if (Model.Processed == false)
                {
                    <option value="false" selected>Pending</option>
                }
                else
                {
                    <option value="false">Pending</option>
                }
                @if (Model.Processed == true)
                {
                    <option value="true" selected>Processed</option>
                }
                else
                {
                    <option value="true">Processed</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-3 text-md-end text-muted small">
            @Model.Messages.TotalCount message(s)
        </div>
    </div>
</form>

@if (Model.Messages.Items.Count == 0)
{
    <div class="alert alert-info">No messages match the selected filters.</div>
}
else
{
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Occurred</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Retries</th>
                    <th>Error</th>
                    <th>Payload</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in Model.Messages.Items)
                {
                    <tr>
                        <td class="text-nowrap">@message.OccurredOn.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td>
                        <td><code>@message.Type</code></td>
                        <td>
                            @if (message.ProcessedOn is not null)
                            {
                                <span class="badge bg-success">Processed</span>
                                <div class="small text-muted">@message.ProcessedOn.Value.ToLocalTime().ToString("dd MMM HH:mm:ss")</div>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>@message.RetryCount</td>
                        <td class="small text-danger">@message.Error</td>
                        <td>
                            <details>
                                <summary class="small">View JSON</summary>
                                <pre class="small mb-0 mt-2" style="white-space: pre-wrap; word-break: break-word;">@message.Payload</pre>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Messages.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Outbox message pages">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Messages.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Messages"
                       asp-route-type="@Model.Type"
                       asp-route-processed="@Model.Processed"
                       asp-route-page="@(Model.Messages.Page - 1)">Previous</a>
                </li>
                @for (var i = 1; i <= Model.Messages.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Messages.Page ? "active" : "")">
                        <a class="page-link" asp-action="Messages"
                           asp-route-type="@Model.Type"
                           asp-route-processed="@Model.Processed"
                           asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Messages.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Messages"
                       asp-route-type="@Model.Type"
                       asp-route-processed="@Model.Processed"
                       asp-route-page="@(Model.Messages.Page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
}
