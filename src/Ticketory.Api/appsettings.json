{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ticketory;Username=ticketory",
    "Redis": "localhost:6379"
  },
  "Database": {
    "Password": "",
    "InitializeOnStartup": true
  },
  "Redis": {
    "Password": "",
    "InstanceName": "ticketory:",
    "AbortOnConnectFail": false,
    "DataProtectionKeyName": "ticketory:data-protection-keys"
  },
  "Caching": {
    "EventListTtlSeconds": 30,
    "EventDetailsTtlSeconds": 120,
    "DashboardTtlSeconds": 15,
    "VersionTtlDays": 365
  },
  "Locks": {
    "ExpirySeconds": 30,
    "WaitSeconds": 5,
    "RetryDelayMilliseconds": 100
  },
  "Outbox": {
    "BatchSize": 20,
    "PollIntervalSeconds": 2,
    "MaxRetries": 5
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "ticketory",
    "Password": "",
    "UseTls": false,
    "ClientName": "ticketory-api",
    "Exchange": "ticketory.events",
    "RetryExchange": "ticketory.retry",
    "DeadLetterExchange": "ticketory.dlx",
    "DeadLetterQueue": "ticketory.dead-letter",
    "PrefetchCount": 5,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 5000,
    "ReconnectDelaySeconds": 5
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "no-reply@ticketory.local",
    "UseStartTls": false
  },
  "Jwt": {
    "Issuer": "Ticketory",
    "Audience": "Ticketory.Clients",
    "Secret": "",
    "ExpiryMinutes": 120,
    "ClockSkewSeconds": 30
  },
  "Seed": {
    "AdminEmail": "admin@ticketory.local",
    "AdminPassword": "",
    "OrganizerEmail": "organizer@ticketory.local",
    "OrganizerPassword": "",
    "CustomerEmail": "customer@ticketory.local",
    "CustomerPassword": "",
    "DemoData": true
  },
  "ExternalTools": {
    "GrafanaUrl": "http://localhost:3000",
    "DozzleUrl": "http://localhost:8888",
    "RabbitMqUrl": "http://localhost:15672",
    "PrometheusUrl": "http://localhost:9090",
    "MailpitUrl": "http://localhost:8025"
  },
  "Instance": {
    "Id": "local"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
